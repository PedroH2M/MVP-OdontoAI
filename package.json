{
  "name": "odonto-ai-saas",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS Multi-tenant de Recepcionista IA e Gestão de Agenda para Clínicas Odontológicas",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm --workspace=@odonto-ai/database run db:generate",
    "db:generate": "npm --workspace=@odonto-ai/database run db:generate",
    "db:push": "npm --workspace=@odonto-ai/database run db:push",
    "db:seed": "npm --workspace=@odonto-ai/database run db:seed",
    "dev:api": "npm --workspace=@odonto-ai/api run dev",
    "dev:web": "npm --workspace=@odonto-ai/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
